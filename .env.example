# --- Telegram ---
BOT_TOKEN=123456:ABC-votre-token-botfather
# Liste des IDs Telegram admin, séparés par des virgules
ADMIN_IDS=111111111,222222222

# --- Base de données ---
# SQLite par défaut (nécessite un volume Railway monté sur /app/data)
DATABASE_URL=sqlite+aiosqlite:///./data/datamega.db
# Exemple PostgreSQL (Railway propose un plugin Postgres) :
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# --- NOWPayments ---
NOWPAYMENTS_API_KEY=votre-cle-api-nowpayments
NOWPAYMENTS_IPN_SECRET=votre-secret-ipn-nowpayments

# --- Divers ---
SUPPORT_USERNAME=@votre_support
MIN_DEPOSIT_USD=5
LOW_STOCK_THRESHOLD=3

# --- Filet de secours dépôts (optionnel, valeurs par défaut raisonnables) ---
# Intervalle entre deux revérifications des dépôts non confirmés auprès de
# NOWPayments (en secondes).
DEPOSIT_POLL_INTERVAL_SECONDS=60
# Au-delà de ce délai sans confirmation, un dépôt passe en statut "expired"
# et n'est plus revérifié (en heures).
DEPOSIT_POLL_MAX_AGE_HOURS=24

# Au-delà de ce délai, une unité de stock réservée (ou une commande en
# attente) sans que l'achat n'ait abouti est considérée comme orpheline
# (crash du bot pendant un achat) et automatiquement libérée (en minutes).
STALE_RESERVATION_TIMEOUT_MINUTES=15

# Fourni automatiquement par Railway, à ne pas définir manuellement en prod
PORT=8080
